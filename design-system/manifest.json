  "components": [
    {
      "name": "Logo",
      "group": "Brand",
      "summary": "The ICYRE brand mark — a \"glint card\" symbol (a portrait card outline with a four-point spark) and a stroke-built geometric wordmark."
    },
    {
      "name": "Surface",
      "group": "Brand",
      "summary": "The three ICYRE materials: Neutral, Elevated and Collectible — every container is one of them."
    },
    {
      "name": "Icon",
      "group": "Brand",
      "summary": "Line icons on a 24px grid with a 1.75 stroke, round caps and joins — one weight across the set."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Text buttons for actions; six variants, three sizes, loading built in."
    },
    {
      "name": "IconButton",
      "group": "Actions",
      "summary": "Square icon-only control with an accessible label and toggle support."
    },
    {
      "name": "Input",
      "group": "Forms",
      "summary": "Single-line text field with label, hint, error and optional leading icon."
    },
    {
      "name": "SearchInput",
      "group": "Forms",
      "summary": "The app-wide pill search field with keyboard shortcut hint and clear button."
    },
    {
      "name": "Textarea",
      "group": "Forms",
      "summary": "Multi-line text field with an optional character counter."
    },
    {
      "name": "Checkbox",
      "group": "Forms",
      "summary": "Multi-select control with label, description and indeterminate state."
    },
    {
      "name": "RadioGroup",
      "group": "Forms",
      "summary": "A fieldset of mutually exclusive options (Radio items)."
    },
    {
      "name": "Switch",
      "group": "Forms",
      "summary": "Instant on/off toggle for preferences that apply immediately."
    },
    {
      "name": "Slider",
      "group": "Forms",
      "summary": "Accessible range control built on a native input with a custom track."
    },
    {
      "name": "Avatar",
      "group": "Display",
      "summary": "Round user/artist image with an initials fallback."
    },
    {
      "name": "Badge",
      "group": "Display",
      "summary": "Small status or content marker."
    },
    {
      "name": "Tag",
      "group": "Display",
      "summary": "Static metadata label (genre, year, mood), optionally removable."
    },
    {
      "name": "Chip",
      "group": "Display",
      "summary": "Pill toggle for filters."
    },
    {
      "name": "Tooltip",
      "group": "Overlays",
      "summary": "Short inverse label for icon-only controls, shown on hover/focus after 300ms."
    },
    {
      "name": "Dropdown",
      "group": "Overlays",
      "summary": "A trigger that opens a Menu of actions or single-choice options."
    },
    {
      "name": "ContextMenu",
      "group": "Overlays",
      "summary": "Right-click menu for tracks, albums and playlists."
    },
    {
      "name": "Popover",
      "group": "Overlays",
      "summary": "Non-modal floating panel for small rich content (sleep timer, share, quick settings)."
    },
    {
      "name": "Modal",
      "group": "Overlays",
      "summary": "Blocking dialog for confirmations and short focused tasks."
    },
    {
      "name": "Drawer",
      "group": "Overlays",
      "summary": "Side (desktop/tablet) or bottom (mobile) sheet for the queue, lyrics and filters."
    },
    {
      "name": "Toast",
      "group": "Overlays",
      "summary": "Transient confirmation at the bottom of the screen."
    },
    {
      "name": "Tabs",
      "group": "Navigation",
      "summary": "Underline tabs for sections within a page (Overview · Tracks · About)."
    },
    {
      "name": "SegmentedControl",
      "group": "Navigation",
      "summary": "Compact switch between 2–5 views of the same content (grid/list, time ranges)."
    },
    {
      "name": "SidebarItem",
      "group": "Navigation",
      "summary": "Desktop sidebar navigation row."
    },
    {
      "name": "TopNavItem",
      "group": "Navigation",
      "summary": "Header navigation link with a 2px iridescent-progress underline when active."
    },
    {
      "name": "MobileNavItem",
      "group": "Navigation",
      "summary": "Bottom navigation item for mobile (≤ 767px)."
    },
    {
      "name": "Breadcrumb",
      "group": "Navigation",
      "summary": "Hierarchy trail for deep library pages."
    },
    {
      "name": "Skeleton",
      "group": "Feedback",
      "summary": "Shimmering placeholder that mirrors the final layout while content loads."
    },
    {
      "name": "Progress",
      "group": "Feedback",
      "summary": "Linear progress for downloads, imports and syncs."
    },
    {
      "name": "Spinner",
      "group": "Feedback",
      "summary": "Compact circular busy indicator."
    },
    {
      "name": "Divider",
      "group": "Feedback",
      "summary": "Hairline separator, horizontal or vertical, optionally with an overline label."
    },
    {
      "name": "MediaCard",
      "group": "Media",
      "summary": "The base card primitive for any media object — artwork in a thin frame plus a two-line meta block."
    },
    {
      "name": "AlbumCard",
      "group": "Media",
      "summary": "MediaCard for albums, EPs and singles: square cover, title, \"Artist · Year\"."
    },
    {
      "name": "ArtistCard",
      "group": "Media",
      "summary": "MediaCard for artists: circular portrait, centered name and listener count."
    },
    {
      "name": "PlaylistCard",
      "group": "Media",
      "summary": "MediaCard for playlists — the cover sits on two offset layers, a stacked \"pile of cards\" that signals a collection."
    },
    {
      "name": "FeaturedCard",
      "group": "Media",
      "summary": "The collectible: ICYRE's premium presentation for one featured release."
    },
    {
      "name": "TrackRow",
      "group": "Media",
      "summary": "Dense track-list row: index/play, cover, title + artist, album, badge, like, duration, more."
    },
    {
      "name": "PlayerButton",
      "group": "Player",
      "summary": "Transport controls: play/pause, previous, next, shuffle, repeat."
    },
    {
      "name": "ProgressBar",
      "group": "Player",
      "summary": "Seek bar with elapsed/total time labels and buffered range."
    },
    {
      "name": "VolumeSlider",
      "group": "Player",
      "summary": "Mute toggle plus a neutral volume slider."
    },
    {
      "name": "TimeLabel",
      "group": "Player",
      "summary": "Monospace, tabular time readout."
    },
    {
      "name": "PlaybackState",
      "group": "Player",
      "summary": "Three-bar indicator for playing, paused and buffering."
    },
    {
      "name": "QueueItem",
      "group": "Player",
      "summary": "Compact row for the Up Next queue."
    },
    {
      "name": "Showcase",
      "group": "Examples",
      "summary": "A full album screen composed only from ICYRE components — the reference for how the system reads at product scale.",
      "page": true
    }
  ],
