{
  "name": "icyre",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @icyre/web dev",
    "dev:real": "bun run --filter @icyre/web dev:real",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "tokens": "bun run --filter @icyre/web tokens",
    "typecheck:scripts": "tsc -p scripts",
    "stack:build": "bun scripts/compose-build.ts",
    "stack:up": "bun scripts/compose-build.ts && docker compose up -d"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "~6.0.3"
  }
}
