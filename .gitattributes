# Normalize line endings in the repository.
* text=auto

# Files executed or read inside Linux containers must keep LF even on a
# Windows checkout (core.autocrlf=true): with CRLF, bash/sh fail on "\r"
# (e.g. "set: pipefail: invalid option name", exit 2 in kafka-init).
*.sh      text eol=lf
*.conf    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
Dockerfile text eol=lf

# Byte-compared proto and Go module/workspace files must keep LF even on
# Windows checkouts (core.autocrlf=true) so proto-check/work-check/mod-check match.
*.proto   text eol=lf
*.pb.go   text eol=lf
go.mod    text eol=lf
go.sum    text eol=lf
go.work   text eol=lf
go.work.sum text eol=lf
